# Copy this file to .env and fill in your keys.
# Never commit .env or share your secret keys.

# Port for the local server
PORT=5173

# Public address of the site, used for the PayMongo success and cancel pages.
# Local testing: http://localhost:5173   Live: https://your-domain.com
SITE_URL=http://localhost:5173

# PayMongo Dashboard > Developers > API keys
# Public key (pk_...) is optional; the hosted checkout only needs the secret key.
PAYMONGO_PUBLIC_KEY=pk_test_replace_me
# Use sk_test_... while testing, then sk_live_... when you go live.
PAYMONGO_SECRET_KEY=sk_test_replace_me

# PayMongo Dashboard > Developers > Webhooks
# Create a webhook pointing to https://your-domain.com/api/paymongo/webhook
# subscribed to "checkout_session.payment.paid", then paste its secret here.
PAYMONGO_WEBHOOK_SECRET=whsk_replace_me

# Payment methods shown on the PayMongo page. Only list methods enabled on your account.
PAYMONGO_PAYMENT_METHODS=qrph
