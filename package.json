{
  "name": "angelos-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Angelo's Homemade Meat Products online shop with PayMongo checkout",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && node --env-file-if-exists=.env server/server.js",
    "dev": "npm run build && node --watch --env-file-if-exists=.env server/server.js",
    "test": "node --test \"server/test/*.test.js\""
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
